{
  "buildCommand": "node scripts/build-data.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/assets/product-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/cloud.js": {
      "includeFiles": "{outputs/**/*.json,products.json,version.json,knowledge-core.js}",
      "maxDuration": 60
    },
    "api/practice-submit.js": {
      "includeFiles": "{outputs/**/*.json,products.json,version.json,knowledge-core.js}",
      "maxDuration": 60
    },
    "api/internal-practice-setup.js": {
      "includeFiles": "{outputs/**/*.json,products.json,version.json,knowledge-core.js}",
      "maxDuration": 60
    },
    "api/health.js": {
      "includeFiles": "{outputs/**/*.json,products.json,version.json,knowledge-core.js}",
      "maxDuration": 10
    }
  }
}
