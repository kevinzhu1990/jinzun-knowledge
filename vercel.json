{
  "buildCommand": "node scripts/apply_product_corrections.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/assets/product-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/cloud.js": {
      "includeFiles": "outputs/**/*.json",
      "maxDuration": 60
    },
    "api/practice-submit.js": {
      "includeFiles": "outputs/**/*.json",
      "maxDuration": 60
    },
    "api/internal-practice-setup.js": {
      "includeFiles": "outputs/**/*.json",
      "maxDuration": 60
    },
    "api/questions.js": {
      "includeFiles": "outputs/**/*.json",
      "maxDuration": 60
    },
    "api/admin-questions.js": {
      "includeFiles": "outputs/**/*.json",
      "maxDuration": 60
    }
  }
}
