  "clauses": [
    {
      "clauseId": "PIPL-4",
      "heading": "个人信息定义与处理",
      "text": "个人信息是与已识别或者可识别的自然人有关的信息；个人信息的处理包括收集、存储、使用、加工、传输、提供、公开、删除。",
      "certainty": "explicit"
    },
    {
      "clauseId": "PIPL-5-6",
      "heading": "合法正当必要与最小范围",
      "text": "处理个人信息应当遵循合法、正当、必要和诚信原则；应当具有明确合理的目的并与处理目的直接相关，收集应限于实现处理目的的最小范围。",
      "certainty": "explicit"
    }
  ]
}

