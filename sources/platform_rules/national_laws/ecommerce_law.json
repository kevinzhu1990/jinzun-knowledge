  "clauses": [
    {
      "clauseId": "ECOM-5",
      "heading": "诚信经营与消费者保护",
      "text": "电子商务经营者从事经营活动，应当遵循自愿、平等、公平、诚信原则，履行消费者权益保护、知识产权保护、网络安全与个人信息保护等义务。",
      "certainty": "explicit"
    },
    {
      "clauseId": "ECOM-17",
      "heading": "商品信息真实准确",
      "text": "电子商务经营者应当全面、真实、准确、及时地披露商品或者服务信息，保障消费者的知情权和选择权。",
      "certainty": "explicit"
    }
  ]
