  "sourceSha256": "f9d14ce3af6d3f57a9aca33e85e9c839a46cd3227fb62a4a8d742426a8d677d1",
  "clauses": [
    {
      "clauseId": "AD-3-4",
      "heading": "真实合法与不得误导",
      "text": "广告应当真实、合法；广告不得含有虚假或者引人误解的内容，不得欺骗、误导消费者。",
      "certainty": "explicit"
    },
    {
      "clauseId": "AD-8",
      "heading": "商品信息真实准确",
      "text": "广告对商品性能、功能、产地、用途、质量、成分、价格、生产者、有效期限、允诺等作表示的，应当准确、清楚、明白。",
      "certainty": "explicit"
    },
    {
      "clauseId": "AD-9",
      "heading": "广告内容限制",
      "text": "广告不得使用法律法规禁止的内容，不得以虚假、夸大或引人误解的方式表达商品信息。",
      "certainty": "explicit"
    }
  ]
}

