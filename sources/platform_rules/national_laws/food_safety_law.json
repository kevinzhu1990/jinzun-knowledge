  "clauses": [
    {
      "clauseId": "FSL-73",
      "heading": "食品广告不得涉及疾病功能",
      "text": "食品广告的内容应当真实合法，不得含有虚假内容，不得涉及疾病预防、治疗功能。",
      "certainty": "explicit"
    },
    {
      "clauseId": "FSL-67",
      "heading": "食品标签真实准确",
      "text": "食品安全标准应当包括食品、食品添加剂的标签、标志和说明书的要求；食品标签和说明书应当真实，不得含有虚假内容。",
      "certainty": "explicit"
    }
  ]
